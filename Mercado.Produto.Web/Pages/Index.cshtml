@page
@using ProdutoEntidade = Mercado.Produto.Domain.Produto
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}


<div class="container mt-4">
    <h2>Produtos</h2>
    <a class="btn btn-primary mb-3" asp-page="Create">Novo Produto</a>
    <table class="table table-striped table-responsive">
        <thead>
            <tr>
                <th>SKU</th>
                <th>Nome</th>
                <th>Preço</th>
                <th>Categoria</th>
                <th>Validade</th>
                <th>Estoque</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Produtos != null && Model.Produtos.Count > 0)
        {
            foreach (var produto in Model.Produtos)
            {
                <tr>
                    <td>@produto.Sku</td>
                    <td>@produto.Nome</td>
                    <td>@produto.PrecoVenda.ToString("C")</td>
                    <td>@produto.Categoria</td>
                    <td>@(produto.DataValidade?.ToString("dd/MM/yyyy") ?? "-")</td>
                    <td>@produto.EstoqueAtual</td>
                    <td>
                        <a class="btn btn-sm btn-warning" asp-page="Edit" asp-route-id="@produto.Id">Editar</a>
                        <a class="btn btn-sm btn-danger" asp-page="Delete" asp-route-id="@produto.Id">Excluir</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="7" class="text-center">Nenhum produto cadastrado.</td></tr>
        }
        </tbody>
    </table>
</div>
